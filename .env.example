# Never commit real provider or database credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CATALOGUE_SOURCE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=chedmed
POSTGRES_USER=chedmed
POSTGRES_PASSWORD=replace-me
CHEDMED_WEBHOOK_SECRET=replace-me
GROQ_API_KEY=replace-me
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3
GEMINI_API_KEY=replace-me
GEMINI_AUDIO_MODEL=gemini-3.6-flash
AUDIO_TRANSCRIPTION_MODE=fallback
AUDIO_FALLBACK_ENABLED=true
AUDIO_MAX_BYTES=19922944
AUDIO_ALLOWED_MIME_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp3,audio/mp4,audio/x-m4a,audio/ogg,audio/flac,audio/x-flac,audio/aiff,audio/aac,audio/webm
AUDIO_QUALITY_THRESHOLD=0.65
AUDIO_MAX_NO_SPEECH_PROB=0.60
AUDIO_MIN_AVG_LOGPROB=-1.0
AUDIO_LOG_TRANSCRIPTS=false
IMAGE_SEARCH_ENABLED=true
GEMINI_IMAGE_MODEL=gemini-2.5-flash
IMAGE_MAX_BYTES=10485760
IMAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif
